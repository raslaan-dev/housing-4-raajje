{
  "name": "@housing/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev:worker": "wrangler dev",
    "deploy": "node ../../scripts/wrangler.mjs d1 migrations apply DB --remote --env=\"\" && node ../../scripts/wrangler.mjs deploy --env=\"\"",
    "deploy:preview": "node ../../scripts/wrangler.mjs d1 migrations apply DB --remote --env preview && node ../../scripts/wrangler.mjs deploy --env preview"
  },
  "dependencies": {
    "@clerk/backend": "^3.22.0",
    "@housing/shared": "*",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "prisma": "^6.19.3",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.149.0"
  }
}
